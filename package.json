{
  "name": "@jccdex/jdid-dapp-sdk",
  "version": "0.0.1",
  "description": "JDID dApp SDK:契约单一来源(contract/methods.json)→ 类型/常量生成 → conformance/校准/MCP",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./mock": "./src/mock.js",
    "./methods": "./src/methods.js"
  },
  "bin": {
    "jdid-dapp-conformance": "cli/conformance.mjs",
    "jdid-wallet-mcp": "mcp/server.mjs",
    "create-jdid-dapp": "cli/create-dapp.mjs"
  },
  "files": [
    "src",
    "contract",
    "schema",
    "cli",
    "docs",
    "mcp",
    "examples",
    "dsh"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "conformance": "node cli/conformance.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm run gen:check && npm test && npm run conformance",
    "mcp": "node mcp/server.mjs",
    "create": "node cli/create-dapp.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GinMu/jdid-dapp-sdk.git"
  },
  "keywords": [
    "jdid",
    "dapp",
    "did",
    "eip-1193",
    "wallet"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  }
}
