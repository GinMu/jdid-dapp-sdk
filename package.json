{
  "name": "@jdid/dapp-sdk",
  "version": "0.1.0",
  "description": "JDID dApp SDK 最小骨架:契约单一来源(contract/methods.json)→ 类型/常量生成 → conformance CLI",
  "private": true,
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./mock": "./src/mock.js",
    "./methods": "./src/methods.js"
  },
  "bin": {
    "jdid-dapp-conformance": "./cli/conformance.mjs"
  },
  "files": [
    "src",
    "contract",
    "schema",
    "cli",
    "docs"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "conformance": "node cli/conformance.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm run gen:check && npm test && npm run conformance",
    "mcp": "node mcp/server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
